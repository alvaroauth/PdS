# Firma la cookie de sesión de Flask. Generar una propia:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-un-valor-aleatorio

# Documento de descubrimiento OIDC del proveedor (Google en esta demo).
OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Credenciales del cliente registrado en la consola del proveedor.
# El client_id identifica la app (no es secreto); el client_secret sí lo es.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 1 = pedir la pantalla de consentimiento en cada ingreso (útil para mostrarla en clase).
OIDC_FORZAR_CONSENTIMIENTO=1

# 1 = pedir también lectura del calendario (scope calendar.readonly) para la página /agenda.
# Requiere habilitar "Google Calendar API" en el proyecto. 0 = sólo identidad.
OIDC_PEDIR_CALENDARIO=1

# Permiso LOCAL: cuentas que pueden aprobar solicitudes, como "iss|sub" separados por coma.
# Copiar el valor exacto desde la página /perfil después de ingresar.
JEFES_DE_SERVICIO=
